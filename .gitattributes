# Keep source files deterministic across Windows and Linux without a bulk rewrite.
*.py text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.json text eol=lf
requirements.txt text eol=lf

# Runtime and binary assets must never be text-normalized.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.exe binary
*.pyc binary
